{
  "name": "draw-steel-unofficial",
  "version": "1.0.0",
  "description": "CSS & Compendium compiler for the Draw Steel system",
  "scripts": {
    "watch": "sass src/scss/draw-steel-unofficial.scss css/draw-steel-unofficial.css --style=expanded --source-map --watch",
    "build:css": "sass src/scss/draw-steel-unofficial.scss css/draw-steel-unofficial.css --style=expanded --no-source-map",
    "build:clean": "node ./src/packs/packs.mjs package clean",
    "build:db": "node ./src/packs/packs.mjs package pack",
    "build:json": "node ./src/packs/packs.mjs package unpack"
  },
  "browserslist": [
    "last 3 versions"
  ],
  "author": "Needless Mustard",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "sass": "^1.53.0",
    "@foundryvtt/foundryvtt-cli": "^1.0.0-rc.4",
    "fancy-log": "^2.0.0",
    "yargs": "^17.7.2"
  }
}