<form class="{{cssClass}} {{actor.type}} flexcol" autocomplete="off">

  {{!-- Sheet Header --}}
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" height="100" width="100" />
    <div class="header-fields">
      <div class="resources grid grid-2col">
        <div class="resource flex-group-center">
          <h1 class="charname"><input name="name" type="text" value="{{actor.name}}" placeholder="Name" /></h1>
        </div>

        <div class="resource flex-group-center">
          <h1 class="system.role"><input for="{{system.role}}" name="system.role" type="text" value="{{system.role}}" placeholder="Role" /></h1>
        </div>
      </div>
      
      
      <div class="resources grid grid-3col">

        {{!-- "flex-group-center" is also defined in the _grid.scss file
        and it will add a small amount of padding, a border, and will
        center all of its child elements content and text. --}}
        <div class="resource flex-group-center">
          <label for="system.stamina.value" class="resource-label">Stamina</label>
          <div class="resource-content flexrow flex-center flex-between">
            <input type="text" name="system.stamina.value" value="{{system.stamina.value}}" data-dtype="Number" />
            <span> / </span>
            <input type="text" name="system.stamina.max" value="{{system.stamina.max}}" data-dtype="Number" />
          </div>
        </div>

        <div class="resource flex-group-center">
          <label for="system.cr" class="resource-label">EV</label>
          <div class="resource-content flexrow flex-center flex-between">
            <input type="text" name="system.ev" value="{{system.ev}}" data-dtype="Number" />
          </div>
        </div>

        <div class="resource flex-group-center">
          <label for="system.attributes.lvl.value" class="resource-label">Level</label>
          <div class="resource-content flexrow flex-center flex-between">
            <input type="text" name="system.attributes.lvl.value" value="{{system.attributes.lvl.value}}"
              data-dtype="Number" />
          </div>
        </div>

      </div>
      <div class="attributes grid grid-5col">

        <div class="attribute flex-group-center">
          <label for="system.attributes.rch.value" class="resource-label rollable flexlarge align-left" 
            data-roll="2d10+@attributes.rch.value" data-label="Reach">Reach</label>
          <input type="text" name="system.attributes.rch.value" value="{{system.attributes.rch.value}}" data-dtype="Number" />
        </div>
        <div class="attribute flex-group-center">
          <label for="system.attributes.siz.value" class="resource-label rollable flexlarge align-left"
            data-roll="2d10+@attributes.siz.value" data-label="Size">Size</label>
          <input type="text" name="system.attributes.siz.value" value="{{system.attributes.siz.value}}" data-dtype="Number" />
        </div>
        <div class="attribute flex-group-center">
          <label for="system.attributes.spd.value" class="resource-label rollable flexlarge align-left"
            data-roll="2d10+@attributes.spd.value" data-label="Speed">Speed</label>
          <input type="text" name="system.attributes.spd.value" value="{{system.attributes.spd.value}}" data-dtype="Number" />
        </div>
        <div class="attribute flex-group-center">
          <label for="system.attributes.stb.value" class="resource-label rollable flexlarge align-left"
            data-roll="2d10+@attributes.stb.value" data-label="Stability">Stability</label>
          <input type="text" name="system.attributes.stb.value" value="{{system.attributes.stb.value}}" data-dtype="Number" />
        </div>
        <div class="attribute flex-group-center">
          <label for="system.attributes.wgt.value" class="resource-label rollable flexlarge align-left"
            data-roll="2d10+@attributes.wgt.value" data-label="Weight">Weight</label>
          <input type="text" name="system.attributes.wgt.value" value="{{system.attributes.wgt.value}}" data-dtype="Number" />
        </div>

      </div>
    </div>
  </header>

  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    {{!-- Default tab is specified in actor-sheet.mjs --}}
    <a class="item" data-tab="features">Features</a>
    <a class="item" data-tab="description">Description</a>
    <a class="item" data-tab="effects">Effects</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">

    {{!-- Owned Features Tab --}}
    <div class="tab features" data-group="primary" data-tab="features">

      <section class="grid grid-3col">
        <aside class="sidebar">
          {{!-- The grid classes are defined in scss/global/_grid.scss. To use,
          use both the "grid" and "grid-Ncol" class where "N" can be any number
          from 1 to 12 and will create that number of columns. --}}
          <div class="abilities flexcol">
            {{#each system.abilities as |ability key|}}
            <div class="ability flexrow flex-group-center">
              <label for="system.abilities.{{key}}.value" class="resource-label rollable flexlarge align-left"
                data-roll="2d10+@abilities.{{key}}.value" data-label="{{ability.label}}">{{ability.label}}</label>
              <input type="text" name="system.abilities.{{key}}.value" value="{{ability.value}}" data-dtype="Number" />
            </div>
            {{/each}}
          </div>
        </aside>

        {{!-- For the main features list, span the right two columns --}}
        <section class="main grid-span-2">
          {{!-- This is a Handlebars partial. They're stored in the `/parts` folder next to this sheet, and defined in
          module/helpers/templates.mjs --}}
          {{> "systems/draw-steel-unofficial/templates/actor/parts/actor-features.hbs"}}
        </section>
      </section>
    </div>

    {{!-- Biography Tab --}}
    <div class="tab biography" data-group="primary" data-tab="description">
      {{!-- If you want TinyMCE editors to output inline rolls when rendered, you need to pass the actor's roll data to
      the rollData property. --}}
      {{editor system.biography target="system.biography" rollData=rollData button=true owner=owner editable=editable}}
    </div>

    {{!-- Active Effects Tab --}}
    <div class="tab effects flexcol" data-group="primary" data-tab="effects">
      {{> "systems/draw-steel-unofficial/templates/actor/parts/actor-effects.hbs"}}
    </div>

  </section>
</form>